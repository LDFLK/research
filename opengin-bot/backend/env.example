# DATA PLATFORM API
READ_API_URL=https://your-api-url-here.com/data-platform/read-api/v1.1

# LLM PROVIDER SELECTION
# The system prioritizes DeepSeek if both options are present

# --- OPTION 1: GROQ --- (Comment Option 2 if using this)
GROQ_API_KEY=gsk_your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b
SUMMARIZER_LLM_MODEL=llama-3.1-8b-instant

# --- OPTION 2: DEEPSEEK 
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# LLM_MODEL=deepseek-chat
# SUMMARIZER_LLM_MODEL=deepseek-chat

# RUNTIME SETTINGS
MAX_TOKENS=3000 # Required for app validation, though currently unused in agent logic